# ─── jetlag-hide-seek (append to ~/homeserver/.env.example) ─────────────────
# No secrets are needed: every variable is optional (defaults shown).
# They are passed to the container explicitly by the compose entry.

# Log verbosity: debug | info | warn | error
JETLAG_LOG_LEVEL=info
# Days before an inactive game is deleted
JETLAG_GAME_TTL_DAYS=30
# Days before a short share link (/?s=...) expires
JETLAG_SHARE_TTL_DAYS=180
# Disk budget (MB) for cached map data from Overpass, kept on the USB drive
JETLAG_OVERPASS_CACHE_MB=200
# Days before cached map data is downloaded again
JETLAG_OVERPASS_CACHE_DAYS=7
